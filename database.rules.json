{
  "rules": {
    "games": {
      "$code": {
        ".read": "auth != null && (data.child('players/red/uid').val() === auth.uid || data.child('players/black/uid').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && $code.matches(/^[ABCDEFGHJKMNPQRSTUVWXYZ2-9][ABCDEFGHJKMNPQRSTUVWXYZ2-9][ABCDEFGHJKMNPQRSTUVWXYZ2-9][ABCDEFGHJKMNPQRSTUVWXYZ2-9][ABCDEFGHJKMNPQRSTUVWXYZ2-9][ABCDEFGHJKMNPQRSTUVWXYZ2-9]$/) && newData.child('meta/status').val() === 'waiting' && !newData.child('moves').exists() && !newData.child('result').exists() && ((newData.child('meta/hostColor').val() === 'red' && newData.child('players/red/uid').val() === auth.uid && !newData.child('players/black').exists()) || (newData.child('meta/hostColor').val() === 'black' && newData.child('players/black/uid').val() === auth.uid && !newData.child('players/red').exists()))) || (data.exists() && !newData.exists() && data.child('meta/status').val() !== 'playing' && (data.child('players/red/uid').val() === auth.uid || data.child('players/black/uid').val() === auth.uid)))",
        "meta": {
          ".read": "auth != null",
          "status": {
            ".write": "auth != null && (data.parent().parent().child('players/red/uid').val() === auth.uid || data.parent().parent().child('players/black/uid').val() === auth.uid)",
            ".validate": "newData.val() === 'finished' || (newData.val() === 'playing' && data.val() !== 'finished' && newData.parent().parent().child('players/red/uid').exists() && newData.parent().parent().child('players/black/uid').exists()) || (newData.val() === 'waiting' && !data.exists())"
          },
          "startedAt": {
            ".write": "auth != null && !data.exists() && (data.parent().parent().child('players/red/uid').val() === auth.uid || data.parent().parent().child('players/black/uid').val() === auth.uid)",
            ".validate": "newData.val() === now"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "gameCode": {
            ".validate": "newData.val() === $code"
          },
          "hostColor": {
            ".validate": "newData.val() === 'red' || newData.val() === 'black'"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$color": {
            ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && data.parent().parent().child('meta/status').val() === 'waiting') || (data.child('uid').val() === auth.uid && newData.child('uid').val() === auth.uid))",
            ".validate": "($color === 'red' || $color === 'black') && newData.hasChildren(['uid'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "connected": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "moves": {
          "$idx": {
            ".write": "auth != null && !data.exists() && newData.exists() && data.parent().parent().child('meta/status').val() === 'playing' && !data.parent().parent().child('result').exists() && (($idx.matches(/[02468]$/) && data.parent().parent().child('players/red/uid').val() === auth.uid) || ($idx.matches(/[13579]$/) && data.parent().parent().child('players/black/uid').val() === auth.uid))",
            ".validate": "$idx.matches(/^[0-9]+$/) && $idx.length <= 4 && newData.hasChildren(['fromRow', 'fromCol', 'toRow', 'toCol'])",
            "fromRow": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9 && newData.val() % 1 === 0"
            },
            "toRow": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9 && newData.val() % 1 === 0"
            },
            "fromCol": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8 && newData.val() % 1 === 0"
            },
            "toCol": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8 && newData.val() % 1 === 0"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "result": {
          ".write": "auth != null && newData.exists() && (data.parent().child('players/red/uid').val() === auth.uid || data.parent().child('players/black/uid').val() === auth.uid) && (!data.exists() || (data.child('type').val() === newData.child('type').val() && data.child('winner').val() === newData.child('winner').val()))",
          ".validate": "newData.hasChildren(['type']) && (newData.child('type').val() !== 'resign' || (newData.child('winner').val() === 'black' && newData.parent().child('players/red/uid').val() === auth.uid) || (newData.child('winner').val() === 'red' && newData.parent().child('players/black/uid').val() === auth.uid))",
          "type": {
            ".validate": "newData.val() === 'checkmate' || newData.val() === 'stalemate' || newData.val() === 'perpetualCheck' || newData.val() === 'repetition' || newData.val() === 'resign'"
          },
          "winner": {
            ".validate": "newData.val() === 'red' || newData.val() === 'black'"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}